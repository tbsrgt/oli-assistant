<?xml version="1.0" encoding="utf-8"?>
<!-- Un clignement d'yeux une fois posé. -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:ordering="sequentially">
    <objectAnimator android:propertyName="scaleY" android:valueFrom="1" android:valueTo="1" android:valueType="floatType" android:duration="640" />
    <objectAnimator android:propertyName="scaleY" android:valueFrom="1" android:valueTo="0.1" android:valueType="floatType" android:duration="90" />
    <objectAnimator android:propertyName="scaleY" android:valueFrom="0.1" android:valueTo="1" android:valueType="floatType" android:duration="120" />
</set>
